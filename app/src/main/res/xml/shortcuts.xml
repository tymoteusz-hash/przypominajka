<?xml version="1.0" encoding="utf-8"?>
<!-- Skróty po przytrzymaniu ikony aplikacji – MainActivity czyta adres (StartRequest w AppNavHost). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutId="new_reminder"
        android:shortcutLongLabel="@string/shortcut_new_long"
        android:shortcutShortLabel="@string/shortcut_new_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="przypominajka://open/new"
            android:targetClass="pl.przypominajka.MainActivity"
            android:targetPackage="pl.przypominajka" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_plan"
        android:shortcutId="plan"
        android:shortcutLongLabel="@string/shortcut_plan_long"
        android:shortcutShortLabel="@string/shortcut_plan_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="przypominajka://open/plan"
            android:targetClass="pl.przypominajka.MainActivity"
            android:targetPackage="pl.przypominajka" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_workout"
        android:shortcutId="workout"
        android:shortcutLongLabel="@string/shortcut_workout_long"
        android:shortcutShortLabel="@string/shortcut_workout_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="przypominajka://open/workout"
            android:targetClass="pl.przypominajka.MainActivity"
            android:targetPackage="pl.przypominajka" />
    </shortcut>
</shortcuts>
