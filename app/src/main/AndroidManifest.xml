<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+: zgoda na wyświetlanie powiadomień (pytamy użytkownika w aplikacji). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Ponowne planowanie alarmów po restarcie telefonu. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 12+: dokładne alarmy.
         SCHEDULE_EXACT_ALARM – użytkownik może ją cofnąć w ustawieniach (obsługujemy to w UI).
         USE_EXACT_ALARM (Android 13+) – przyznawana automatycznie aplikacjom typu budzik/przypomnienia.
         Uwaga: publikując w Google Play, USE_EXACT_ALARM wymaga uzasadnienia w deklaracji uprawnień;
         jeśli jej usuniesz, aplikacja nadal działa dzięki SCHEDULE_EXACT_ALARM. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Librus Synergia, quizy AI (Claude) i sprawdzanie aktualizacji na GitHubie. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Instalowanie pobranej nowej wersji (telefon i tak pyta o zgodę). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".PrzypominajkaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Przypominajka">

        <!-- Ikonę w launcherze dają aliasy poniżej (po jednym na wygląd), stąd brak filtra MAIN/LAUNCHER. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Ikona aplikacji zależy od wyglądu (util/AppIconSwitcher.kt): włączony jest dokładnie jeden alias.
             Przed wyborem wyglądu – Dzwon (najbliższy dawnej ikonie z dzwonem).
             Skróty po przytrzymaniu ikony: Nowe przypomnienie, Plan lekcji, Trening. -->
        <activity-alias
            android:name=".LauncherKartka"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_kartka"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_kartka_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".LauncherDzwon"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dzwon"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_dzwon_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".LauncherTablica"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_tablica"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_tablica_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- Przekazuje pobrany plik aktualizacji instalatorowi systemu. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- Koniec przerwy między seriami w Treningu (dokładny alarm). -->
        <receiver
            android:name=".alarm.RestTimerReceiver"
            android:exported="false" />

        <!-- Widżet "Dziś" na ekran główny telefonu. -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- Widżet "Checklista" na ekran główny telefonu. -->
        <receiver
            android:name=".widget.ChecklistWidgetReceiver"
            android:exported="true"
            android:label="@string/checklist_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/checklist_widget_info" />
        </receiver>

        <!-- Szybkie dopisanie punktu z widżetu Checklisty (małe okienko nad ekranem głównym). -->
        <activity
            android:name=".widget.QuickAddActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:noHistory="true"
            android:theme="@style/Theme.Przypominajka.QuickAdd"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <!-- Przypomnienie o treningu na koniec lekcji. -->
        <receiver
            android:name=".alarm.TrainingReminderReceiver"
            android:exported="false" />

        <!-- Wywoływany przez AlarmManager o zaplanowanej godzinie. -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <!-- Przyciski "Zrobione", "Za 10 min" i "Za godzinę" w powiadomieniu. -->
        <receiver
            android:name=".alarm.NotificationActionReceiver"
            android:exported="false" />

        <!-- Przypomnienia punktów Checklisty (alarm + przycisk "Zrobione"). -->
        <receiver
            android:name=".alarm.ChecklistAlarmReceiver"
            android:exported="false" />

        <!-- Po restarcie, aktualizacji aplikacji, zmianie czasu/strefy lub zgody na alarmy
             ponownie planujemy wszystkie aktywne przypomnienia. -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
